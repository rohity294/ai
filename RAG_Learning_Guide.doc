            <style>
                body { font-family: 'Calibri', 'Arial', sans-serif; line-height: 1.5; color: #333; }
                h1 { color: #2c3e50; border-bottom: 2px solid #eee; padding-bottom: 10px; }
                h2 { color: #34495e; margin-top: 25px; border-left: 5px solid #3498db; padding-left: 10px; }
                table { border-collapse: collapse; width: 100%; margin: 20px 0; }
                th, td { border: 1px solid #bdc3c7; padding: 12px; text-align: left; }
                th { background-color: #f8f9fa; font-weight: bold; }
                blockquote { border-left: 4px solid #bdc3c7; padding: 10px 20px; margin: 20px 0; background: #fdfdfd; font-style: italic; }

# Copy to .env-linkedin-automation.local and fill real values.
# Do not commit the .local file.

# OpenClaw core
OPENCLAW_GATEWAY_TOKEN=replace-with-real-gateway-token
OPENAI_API_KEY=replace-with-real-openai-key
OPENCLAW_CONFIG_PATH=/app/config/openclaw.json
OPENCLAW_GATEWAY_BIND=lan

# Approval gate
APPROVAL_REQUIRED=true
APPROVER_WHATSAPP_ALLOWLIST=15551234567,15557654321

# LinkedIn posting
LINKEDIN_ACCESS_TOKEN=replace-with-real-linkedin-user-access-token
LINKEDIN_AUTHOR_URN=urn:li:person:replace-with-person-id
LINKEDIN_API_VERSION=v2

# LinkedIn OAuth (recommended to avoid manual token copy/paste)
LINKEDIN_CLIENT_ID=replace-with-linkedin-client-id
LINKEDIN_CLIENT_SECRET=replace-with-linkedin-client-secret
LINKEDIN_OAUTH_REDIRECT_URI=https://your-render-domain.onrender.com/v1/oauth/linkedin/callback
LINKEDIN_OAUTH_SCOPES=openid profile email w_member_social
LINKEDIN_OAUTH_STATE_TTL_SEC=600
LINKEDIN_OAUTH_AUTO_REFRESH=true

# Internal webhook worker (runs in same container)
LINKEDIN_WORKER_HOST=0.0.0.0
LINKEDIN_WORKER_PORT=
LINKEDIN_WEBHOOK_BASE_URL=https://your-render-domain.onrender.com
LINKEDIN_WEBHOOK_SHARED_SECRET=replace-with-strong-shared-secret
OPENCLAW_INTERNAL_PORT=18080

# External state store (recommended for remote deployment)
STATE_BACKEND=redis
REDIS_KEY_PREFIX=openclaw:linkedin
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
